generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String   @default("Đồ gia dụng")
  price       Int
  oldPrice    Int?
  description String
  images      String[] @default([])
  video       String?
  attributes  Json     @default("[]")
  variants    Json     @default("[]")
  reviews     Json     @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model Order {
  id         String   @id @default(cuid())
  code       String   @unique
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  name       String
  phone      String
  address    String
  attributes Json?
  comboQty   Int?
  price      Int?
  quantity   Int      @default(1)
  source     String?
  status     String   @default("Mới")
  createdAt  DateTime @default(now())
}
